{
  "manifest_version": 3,
  "name": "ChatGPT Orchestra",
  "version": "2.0.0",
  "version_name": "2.0.0-alpha.20",
  "description": "Optional extension companion/fallback for the ChatGPT Orchestra desktop-first alpha.",
  "key": "",
  "permissions": ["storage", "tabs", "alarms", "nativeMessaging"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://api.github.com/*"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "icons": {"16":"icon.png","32":"icon.png","48":"icon.png","128":"icon.png"},
  "action": {
    "default_title": "ChatGPT Orchestra",
    "default_popup": "popup.html",
    "default_icon": {"16":"icon.png","32":"icon.png","48":"icon.png","128":"icon.png"}
  },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
    "js": [
      "content/selectors.js",
      "content/utils.js",
      "content/logger.js",
      "content/message-types.js",
      "protocol/orchestra-protocol.js",
      "content/planning-artifact-parser.js",
      "content/worker-artifact-parser.js",
      "content/generation-state.js",
      "content/protocol-parser.js",
      "content/assistant-message-reader.js",
      "content/composer-adapter.js",
      "content/generation-detector.js",
      "content/runtime-messenger.js",
      "content/chatgpt-adapter.js",
      "content/legacy-controller.js",
      "content.js"
    ],
    "run_at": "document_idle"
  }]
}
